# ============================================================
# KMatch·知链 — Vue3 前端开发态镜像 (docker-compose frontend 服务)
# ============================================================
# 与 compose 的 bind mount (./frontend:/app) 配合: 镜像只装依赖,
# 运行时用 bind 目录里的源码 + Vite HMR; 代理 /api → backend 容器 (VITE_PROXY_TARGET)。
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci || npm install --no-audit --no-fund

COPY . .

ENV VITE_PROXY_TARGET=http://backend:8000

EXPOSE 5173

CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173"]
