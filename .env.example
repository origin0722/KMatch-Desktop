# ============================================================
# KMatch·知链 — 环境变量配置模板
# 复制为 .env 后填入实际值
# ============================================================

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kmatch2026

# --- LLM API (DeepSeek / 通义千问) ---
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro

# --- Embedding（独立配置，未设置时 fallback 到上面的 LLM_*） ---
# ⚠️ 注意：不同供应商的 embedding 模型名和维度不同：
#   OpenAI       → text-embedding-3-small (1536维)  或 text-embedding-3-large (3072维)
#   通义千问      → text-embedding-v2 (1536维)        BASE_URL 需改为 https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek     → 暂不提供公开 embedding API，建议用千问或本地模型
#   本地模型(备选) → BAAI/bge-small-zh-v1.5 (512维)   需 pip install sentence-transformers
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSIONS=1536
VECTOR_INDEX_NAME=knowledge_embeddings

# --- App ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REVIEW_PASS_THRESHOLD=0.85

# --- 沙箱 (code_test 工具, #15) ---
# SANDBOX_MODE: auto (默认, docker 可用则用 Docker 沙箱禁网/限内存, 否则回退子进程) | subprocess (强制子进程) | docker (强制 Docker, 不可用则报错)
SANDBOX_MODE=auto
SANDBOX_DOCKER_IMAGE=kmatch-sandbox:latest
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1

# --- 联网搜索 (Tavily, 学情反馈搜薄弱知识点相关网站) ---
# 免费 key: 注册 https://tavily.com (1000 次/月); 留空则不联网搜索, 只返回 LLM 讲义
TAVILY_API_KEY=
